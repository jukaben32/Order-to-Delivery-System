    {
      "id": "660ceece-1aad-4429-9d51-bdde4336abe7",
      "name": "Order output parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        816,
        336
      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{ \"reply\": \"short message to the customer if something is missing or unclear, otherwise empty\", \"language\": \"es\", \"ready\": false, \"confirmed\": false, \"customer\": { \"name\": \"\", \"phone\": \"\", \"email\": \"\", \"address\": \"\", \"city\": \"\" }, \"items\": [ { \"sku\": \"RICE-5KG\", \"qty\": 2 } ] }"
      }
    },
    {
      "id": "92e61414-2a58-4005-b180-1819c43c5c9e",
      "name": "Price order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = ($json.output && typeof $json.output === 'object') ? $json.output : $json;\nconst request = String($('Order agent trigger').first().json.request || '');\nconst products = $('Read catalog').all().map(function (i) { return i.json; });\nconst en = String(raw.language || 'es').toLowerCase().indexOf('en') === 0;\nfunction money(n) { return 'RD$ ' + Number(n).toLocaleString('en-US'); }\nconst c = raw.customer || {};\nconst customer = { name: String(c.name || '').trim(), phone: String(c.phone || '').trim(), email: String(c.email || '').trim().toLowerCase(), address: String(c.address || '').trim(), city: String(c.city || '').trim() };\nconst merged = {};\n(raw.items || []).forEach(function (it) {\n  const sku = String(it.sku || '').trim();\n  const qty = Math.round(Number(it.qty));\n  if (!sku || !(qty > 0)) { return; }\n  merged[sku] = (merged[sku] || 0) + qty;\n});\nconst errors = [];\nconst items = [];\nconst lines = [];\nlet subtotal = 0;\nObject.keys(merged).forEach(function (sku) {\n  const p = products.find(function (x) { return String(x.SKU) === sku; });\n  const qty = merged[sku];\n  if (!p) { errors.push((en ? 'Unknown product: ' : 'Producto no encontrado: ') + sku); return; }\n  const stock = Number(p.Stock) || 0;\n  if (qty > stock) { errors.push((en ? 'Not enough stock of ' : 'No hay suficiente existencia de ') + p.Name + ' (' + stock + ')'); return; }\n  const price = Number(p.Price) || 0;\n  const lineTotal = price * qty;\n  subtotal += lineTotal;\n  items.push({ sku: sku, qty: qty, name: p.Name, price: price, line_total: lineTotal });\n  lines.push('- ' + qty + ' x ' + p.Name + ' = ' + money(lineTotal));\n});\nconst discount = 0;\nconst total = subtotal - discount;\nconst missing = [];\nif (!customer.name) { missing.push(en ? 'name' : 'nombre'); }\nif (!customer.phone) { missing.push(en ? 'phone' : 'teléfono'); }\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(customer.email)) { missing.push(en ? 'email' : 'correo'); }\nif (!customer.address) { missing.push(en ? 'delivery address' : 'dirección de entrega'); }\nconst hasItems = items.length > 0;\nconst ready = hasItems && missing.length === 0 && errors.length === 0;\nconst confirmed = Boolean(raw.confirmed) && /CUSTOMER CONFIRMED:\\s*YES/i.test(request);\nconst create = ready && confirmed;\nlet reply = '';\nif (errors.length) { reply = errors.join('\\n') + '\\n' + (en ? 'Please adjust your order.' : 'Por favor ajusta tu pedido.'); }\nelse if (!hasItems) { reply = raw.reply || (en ? 'Which products would you like to order?' : '¿Qué productos deseas pedir?'); }\nelse if (missing.length) { reply = (en ? 'To continue I still need your: ' : 'Para continuar necesito tu: ') + missing.join(', ') + '.'; }\nelse { reply = (en ? 'Order summary:' : 'Resumen de tu pedido:') + '\\n' + lines.join('\\n') + '\\nTotal: ' + money(total) + '\\n' + (en ? 'Delivery to: ' : 'Entrega en: ') + customer.address + '\\n' + (en ? 'Do you confirm the order? Reply YES to confirm.' : '¿Confirmas el pedido? Responde SÍ para confirmar.'); }\nreturn [{ json: { create: create, ready: ready, confirmed: confirmed, lang: en ? 'en' : 'es', errors: errors, missing: missing, items: items, subtotal: subtotal, discount: discount, total: total, customer: customer, reply: reply } }];"
      },
      "notes": "Why Code: THIS is where money is calculated. Prices come from the Products sheet, never from the AI. Same input = same total every time. Also checks SKUs and stock, and confirmation needs the exact line CUSTOMER CONFIRMED: YES in the request."
    },
