    {
      "id": "3e090560-b9c4-42b8-b08c-8c91fdae9326",
      "name": "Build confirmation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4160,
        16
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const p = $('Price order').first().json;\nconst a = $('Assign IDs').first().json;\nconst inv = $('Call Billing').first().json;\nconst dsp = $('Call Dispatch').first().json;\nfunction money(n) { return 'RD$ ' + Number(n).toLocaleString('en-US'); }\nconst en = p.lang === 'en';\nconst assigned = dsp.dispatch_status === 'assigned';\nconst invoiceText = inv.invoice_no ? (en ? ' Invoice ' + inv.invoice_no + ' was emailed to ' + p.customer.email + ' (due ' + inv.due_date + ').' : ' La factura ' + inv.invoice_no + ' fue enviada a ' + p.customer.email + ' (vence ' + inv.due_date + ').') : '';\nlet deliveryText;\nif (assigned) { deliveryText = en ? ' ' + dsp.rider_name + ' (' + dsp.vehicle + ') is on the way.' : ' ' + dsp.rider_name + ' (' + dsp.vehicle + ') ya va en camino.'; }\nelse { deliveryText = en ? ' All riders are busy right now, so your order is waiting and will leave as soon as one is free.' : ' Ahora mismo todos los repartidores están ocupados; tu pedido está en espera y saldrá en cuanto haya uno libre.'; }\nconst reply = (en ? 'Order confirmed! Order number: ' : '¡Pedido confirmado! Número de pedido: ') + a.order_id + '. Total: ' + money(p.total) + '.' + invoiceText + deliveryText;\nreturn [{ json: { status: 'confirmed', reply: reply, order_id: a.order_id, total: p.total, invoice_no: inv.invoice_no || '', dispatch_status: dsp.dispatch_status || '' } }];"
      },
      "notes": "Why Code: builds the final customer message from real results (order number, invoice, rider). Amounts come from the Price order code node."
    },
