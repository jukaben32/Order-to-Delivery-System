    {
      "id": "e19cb497-c73b-472f-8285-966e8c9a21a1",
      "name": "Low stock items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $('Compute new stock').all().map(function (i) { return i.json; }).filter(function (r) { return r.low; });\nconst stamp = $now.toFormat('yyyyMMddHHmmss');\nreturn rows.map(function (r, idx) {\n  return { json: { PR_ID: 'PR-' + stamp + '-' + (idx + 1), Date: $now.toFormat('yyyy-MM-dd'), SKU: r.sku, Qty: r.pr_qty, Supplier_Email: r.supplier_email, Status: 'Requested', name: r.name, new_stock: r.new_stock, reorder_level: r.reorder_level, order_id: r.order_id } };\n});"
      },
      "notes": "Why Code: keeps only items whose new stock is below Reorder_Level and sizes the order at 4 x Reorder_Level. Returns 0 items when nothing is low, so the chain simply stops."
    },
