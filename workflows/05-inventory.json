    {
      "id": "30c58f04-15d4-45bf-9b3e-1caf1e0e270f",
      "name": "Build inventory log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $('Compute new stock').all().map(function (i) { return i.json; });\nconst details = rows.map(function (r) { return r.sku + ': ' + r.old_stock + ' -> ' + r.new_stock; }).join('; ');\nreturn [{ json: { Time: $now.toFormat('yyyy-MM-dd HH:mm:ss'), Agent: 'Inventory', Action: 'stock_updated', Ref_ID: rows.length ? rows[0].order_id : '', Details: details } }];"
      },
      "notes": "Why Code: collapses N stock updates into one log row."
    },
