    {
      "id": "671e3fb4-112d-4771-86ca-8d1f173cd62a",
      "name": "Compute new stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $('Inventory trigger').first().json;\nconst items = input.items || [];\nconst products = $input.all().map(function (i) { return i.json; });\nconst out = [];\nitems.forEach(function (it) {\n  const p = products.find(function (x) { return String(x.SKU).trim() === String(it.sku).trim(); });\n  if (!p) { return; }\n  const qty = Number(it.qty) || 0;\n  const stock = Number(p.Stock) || 0;\n  const level = Number(p.Reorder_Level) || 0;\n  const newStock = stock - qty;\n  out.push({ json: { order_id: input.order_id, sku: String(p.SKU), name: p.Name, qty: qty, old_stock: stock, new_stock: newStock, reorder_level: level, supplier_email: p.Supplier_Email, low: newStock < level, pr_qty: 4 * level } });\n});\nreturn out;"
      },
      "notes": "Why Code: matches ordered SKUs to product rows and does the stock subtraction in plain JS. Sheets often returns numbers as text, so values are converted with Number()."
    },
