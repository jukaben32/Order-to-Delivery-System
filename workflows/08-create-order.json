    {
      "id": "aeab97f4-28dc-4be6-8f72-eb9d2ab50b6f",
      "name": "Validate and price",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $('Create order trigger').first().json;\nconst products = $input.all().map(function (i) { return i.json; }).filter(function (p) { return p.SKU; });\nfunction money(n) { return 'RD$ ' + Number(n).toLocaleString('en-US'); }\nconst c = input.customer || {};\nconst customer = {\n  name: String(c.name || '').trim().slice(0, 80),\n  phone: String(c.phone || '').trim().slice(0, 30),\n  email: String(c.email || '').trim().toLowerCase().slice(0, 120),\n  address: String(c.address || '').trim().slice(0, 200),\n  city: String(c.city || '').trim().slice(0, 60)\n};\nconst errors = [];\nif (customer.name.length < 2) { errors.push('Escribe tu nombre.'); }\nif (customer.phone.replace(/\\D/g, '').length < 7) { errors.push('Escribe un teléfono válido (con WhatsApp, si es posible).'); }\nif (customer.email && !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(customer.email)) { errors.push('El correo no parece válido. Puedes dejarlo vacío.'); }\nif (customer.address.length < 5) { errors.push('Escribe tu dirección de entrega.'); }\nconst raw = Array.isArray(input.items) ? input.items : [];\nif (raw.length > 60) { errors.push('El pedido tiene demasiados productos distintos.'); }\nconst merged = {};\nraw.slice(0, 60).forEach(function (it) {\n  const sku = String((it && it.sku) || '').trim();\n  const qty = Math.round(Number(it && it.qty));\n  if (!sku || !(qty > 0)) { return; }\n  merged[sku] = (merged[sku] || 0) + qty;\n});\nconst skus = Object.keys(merged);\nif (!skus.length) { errors.push('Tu carrito está vacío.'); }\nconst items = [];\nlet subtotal = 0;\nskus.forEach(function (sku) {\n  const p = products.find(function (x) { return String(x.SKU) === sku; });\n  const qty = merged[sku];\n  if (!p) { errors.push('El producto ' + sku + ' ya no está disponible.'); return; }\n  if (qty > 99) { errors.push('La cantidad máxima por producto es 99 (' + p.Name + ').'); return; }\n  const stock = Number(p.Stock) || 0;\n  if (qty > stock) { errors.push('No hay suficiente existencia de ' + p.Name + ' (quedan ' + stock + ').'); return; }\n  const price = Number(p.Price) || 0;\n  const lineTotal = price * qty;\n  subtotal += lineTotal;\n  items.push({ sku: sku, qty: qty, name: p.Name, price: price, line_total: lineTotal });\n});\nconst discount = 0;\nconst total = subtotal - discount;\nreturn [{ json: { ok: errors.length === 0, errors: errors, items: items, subtotal: subtotal, discount: discount, total: total, customer: customer, channel: String(input.channel || 'Web').slice(0, 20), payment_method: String(input.payment_method || 'cash_on_delivery').slice(0, 30) } }];"
      },
      "notes": "Why Code: THIS is where money is calculated. The browser only sends SKU + quantity; prices come from the Products sheet. Also validates customer data, SKUs, quantities and stock."
    },
