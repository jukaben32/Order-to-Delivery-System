    {
      "id": "9a0b4825-edd9-4f6f-998f-626c2f04af68",
      "name": "Assign IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const p = $('Validate and price').first().json;\nconst customers = $('Read customers').all().map(function (i) { return i.json; }).filter(function (c) { return c.Customer_ID; });\nconst orders = $input.all().map(function (i) { return i.json; }).filter(function (o) { return o.Order_ID; });\nfunction digits(s) { return String(s || '').replace(/\\D/g, ''); }\nconst existing = customers.find(function (c) { return (digits(c.Phone) && digits(c.Phone) === digits(p.customer.phone)) || (p.customer.email && String(c.Email || '').toLowerCase() === p.customer.email); });\nlet maxC = 1000;\ncustomers.forEach(function (c) { const m = String(c.Customer_ID).match(/^CUS-(\\d+)$/); if (m && Number(m[1]) > maxC) { maxC = Number(m[1]); } });\nlet maxO = 1000;\norders.forEach(function (o) { const m = String(o.Order_ID).match(/^ORD-(\\d+)$/); if (m && Number(m[1]) > maxO) { maxO = Number(m[1]); } });\nconst customerId = existing ? existing.Customer_ID : 'CUS-' + (maxC + 1);\nconst orderId = 'ORD-' + (maxO + 1);\nconst itemsText = p.items.map(function (i) { return i.sku + ' x' + i.qty; }).join('; ');\nreturn [{ json: { order_id: orderId, customer_id: customerId, date: $now.toFormat('yyyy-MM-dd'), items_text: itemsText, customer_row: { Customer_ID: customerId, Name: p.customer.name, Phone: p.customer.phone, Email: p.customer.email, Address: p.customer.address, City: p.customer.city, Created_At: existing && existing.Created_At ? existing.Created_At : $now.toFormat('yyyy-MM-dd HH:mm:ss') } } }];"
      },
      "notes": "Why Code: reuses the Customer_ID when the phone or email already exists, otherwise makes the next CUS number; makes the next ORD number (first is ORD-1001). Ignores the empty placeholder row."
    },
