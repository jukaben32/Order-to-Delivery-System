      {
        "id": "07640a9e-57f7-4151-a685-080e67e27315",
        "name": "Plan channels",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          96
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Why Code: email when a valid email exists; WhatsApp (OpenWA) when the phone is on the test allowlist.\nconst ALLOW = [];   // numbers that may receive WhatsApp messages. Empty = nothing is sent; messages stay as whatsapp_pending.\nconst t = $input.first().json;\nconst email = String(t.customer_email || '').trim().toLowerCase();\nconst hasEmail = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email);\nlet phone = String(t.customer_phone || '').replace(/\\D/g, '');\nif (phone.length === 10) phone = '1' + phone;   // Dominican numbers without country code\nconst sendWa = phone.length >= 11 && ALLOW.includes(phone);\nreturn [{ json: { send_email: hasEmail, email: hasEmail ? email : '', phone, has_phone: phone.length >= 7, send_wa: sendWa, wa_pending: !hasEmail && !sendWa, wa_chat: phone + '@c.us', order_id: String(t.order_id || ''), event: String(t.event || ''), subject: String(t.subject || ''), message: String(t.message || ''), name: String(t.customer_name || '') } }];\n"
        },
        "notes": "Why Code: email when valid; WhatsApp (OpenWA) when the phone is on the test allowlist; otherwise saved as whatsapp_pending."
      },
