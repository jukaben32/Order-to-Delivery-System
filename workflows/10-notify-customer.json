    {
      "id": "07640a9e-57f7-4151-a685-080e67e27315",
      "name": "Plan channels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const t = $input.first().json;\nconst email = String(t.customer_email || '').trim().toLowerCase();\nconst hasEmail = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email);\nconst phone = String(t.customer_phone || '').replace(/\\D/g, '');\nreturn [{ json: { send_email: hasEmail, email: hasEmail ? email : '', phone: phone, has_phone: phone.length >= 7, order_id: String(t.order_id || ''), event: String(t.event || ''), subject: String(t.subject || ''), message: String(t.message || ''), name: String(t.customer_name || '') } }];"
      },
      "notes": "Why Code: decides how to reach the customer. Email only when a valid email exists. WhatsApp is not connected yet, so a customer without email gets the message saved as whatsapp_pending in Activity_Log; connect Evolution API or Meta here later."
    },
