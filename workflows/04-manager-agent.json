    {
      "id": "d6d1fe06-fae5-4cab-b6d9-30ca4d6779eb",
      "name": "Compute report numbers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const DEFAULT_TO = 'owner@example.com';\nconst LATE_MINUTES = 120;\nfunction rows(name) { return $(name).all().map(function (i) { return i.json; }); }\nconst orders = rows('Read orders').filter(function (o) { return o.Order_ID; });\nconst products = rows('Read products').filter(function (p) { return p.SKU; });\nconst invoices = rows('Read invoices').filter(function (i) { return i.Invoice_No; });\nconst dispatch = rows('Read dispatch').filter(function (d) { return d.Dispatch_ID; });\nconst today = $now.toFormat('yyyy-MM-dd');\nconst todays = orders.filter(function (o) { return String(o.Date).slice(0, 10) === today; });\nconst salesToday = todays.reduce(function (s, o) { return s + (Number(o.Total) || 0); }, 0);\nconst lowStock = products.filter(function (p) { return Number(p.Stock) < Number(p.Reorder_Level); }).map(function (p) { return { sku: p.SKU, name: p.Name, stock: Number(p.Stock), reorder_level: Number(p.Reorder_Level) }; });\nconst unpaid = invoices.filter(function (i) { return String(i.Status) !== 'Paid'; }).map(function (i) { return { invoice_no: i.Invoice_No, order_id: i.Order_ID, amount: Number(i.Amount) || 0, due_date: String(i.Due_Date).slice(0, 10), overdue: String(i.Due_Date).slice(0, 10) < today, status: i.Status }; });\nconst unpaidTotal = unpaid.reduce(function (s, i) { return s + i.amount; }, 0);\nconst late = dispatch.filter(function (d) { return String(d.Status) === 'Dispatched'; }).map(function (d) {\n  const t = DateTime.fromFormat(String(d.Dispatched_At), 'yyyy-MM-dd HH:mm:ss', { zone: $now.zoneName });\n  const mins = t.isValid ? Math.round($now.diff(t, 'minutes').minutes) : 0;\n  return { order_id: d.Order_ID, rider: d.Rider, minutes_out: mins };\n}).filter(function (d) { return d.minutes_out > LATE_MINUTES; });\nconst waiting = orders.filter(function (o) { return String(o.Status) === 'Waiting for rider'; }).map(function (o) { return o.Order_ID; });\nlet recipient = DEFAULT_TO;\ntry { recipient = $('Recipient (form)').first().json.recipient || DEFAULT_TO; } catch (e) { recipient = DEFAULT_TO; }\nconst report = { date: today, orders_today: todays.length, sales_today: salesToday, low_stock: lowStock, unpaid_invoices: unpaid, unpaid_total: unpaidTotal, late_deliveries: late, late_after_minutes: LATE_MINUTES, orders_waiting_for_rider: waiting, currency: 'RD$' };\nreturn [{ json: { recipient: recipient, subject: 'Demo Traders - Daily report ' + today, report: report } }];"
      },
      "notes": "Why Code: ALL numbers in the owner report are computed here (sales today, low stock, unpaid invoices, late deliveries). The AI only turns these numbers into words."
    },
    {
      "id": "29b404a9-48c1-4392-8b2e-49d3981bfe75",
      "name": "Report writer",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1568,
        112
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Write the owner report email from this JSON:\n{{ JSON.stringify($json.report) }}",
        "options": {
          "systemMessage": "You write the daily report email for the owner of Demo Traders, a grocery shop. Use ONLY the numbers and names in the JSON you receive. Never calculate, estimate or invent any number. Currency is RD$.\n\nWrite in Spanish, plain text (no markdown symbols), short and clear, with these sections: Ventas de hoy (orders and sales), Stock bajo (each product with its stock and minimum, or say there is none), Facturas sin pagar (count, total, and which ones are overdue), Entregas tardías y pedidos en espera (or say there are none). Start with \"Hola,\" and end with \"Demo Traders\". Do not write a subject line.",
          "maxIterations": 3
        }
      }
    },
