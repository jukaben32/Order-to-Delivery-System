    {
      "id": "45cda53a-4c6f-4e33-b070-e05e9116a9a8",
      "name": "Next invoice number",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const p = $('Billing trigger').first().json;\nlet max = 1000;\n$input.all().forEach(function (i) {\n  const m = String(i.json.Invoice_No || '').match(/^INV-(\\d+)$/);\n  if (m && Number(m[1]) > max) { max = Number(m[1]); }\n});\nconst orderDate = String(p.order_date || $now.toFormat('yyyy-MM-dd')).slice(0, 10);\nconst due = DateTime.fromISO(orderDate).plus({ days: 7 }).toFormat('yyyy-MM-dd');\nreturn [{ json: { Invoice_No: 'INV-' + (max + 1), Order_ID: p.order_id, Date: orderDate, Amount: Number(p.total), Due_Date: due, Status: 'Unpaid', customer_name: p.customer_name, customer_email: p.customer_email || '', customer_phone: p.customer_phone || '' } }];"
      },
      "notes": "Why Code: finds the highest INV number already in the sheet (ignoring the empty placeholder row) and adds 1; first invoice is INV-1001. Due date = order date + 7 days."
    },
