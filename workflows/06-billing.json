    {
      "id": "b3e7be4c-0450-42cf-bef9-f00392dd2fec",
      "name": "Validate payment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const form = $('Record payment form').first().json;\nconst wanted = String(form.Invoice_No || '').trim().toUpperCase();\nconst inv = $('Read invoices for payment').all().map(function (i) { return i.json; }).find(function (r) { return String(r.Invoice_No || '').toUpperCase() === wanted; });\nconst payments = $input.all().map(function (i) { return i.json; }).filter(function (r) { return r.Payment_ID; });\nconst amount = Number(form.Amount);\nif (!inv) { return [{ json: { ok: false, Invoice_No: wanted, message: 'Invoice ' + wanted + ' was not found. Nothing was recorded.' } }]; }\nif (String(inv.Status) === 'Paid') { return [{ json: { ok: false, Invoice_No: inv.Invoice_No, message: 'Invoice ' + inv.Invoice_No + ' is already fully paid. Nothing was recorded.' } }]; }\nif (!(amount > 0)) { return [{ json: { ok: false, Invoice_No: inv.Invoice_No, message: 'The amount must be greater than zero. Nothing was recorded.' } }]; }\nconst due = Number(inv.Amount) || 0;\nconst before = payments.filter(function (p) { return String(p.Invoice_No) === String(inv.Invoice_No); }).reduce(function (s, p) { return s + (Number(p.Amount) || 0); }, 0);\nconst paid = before + amount;\nconst status = paid >= due ? 'Paid' : 'Partial';\nconst balance = Math.max(due - paid, 0);\nlet max = 1000;\npayments.forEach(function (p) { const m = String(p.Payment_ID).match(/^PAY-(\\d+)$/); if (m && Number(m[1]) > max) { max = Number(m[1]); } });\nconst pid = 'PAY-' + (max + 1);\nconst msg = 'Payment ' + pid + ' of RD$ ' + amount + ' recorded. Invoice ' + inv.Invoice_No + ' is now ' + status + (balance > 0 ? ' (balance RD$ ' + balance + ')' : '') + '.';\nreturn [{ json: { ok: true, Payment_ID: pid, Invoice_No: inv.Invoice_No, Order_ID: inv.Order_ID, Date: $now.toFormat('yyyy-MM-dd'), Amount: amount, Method: form.Method, Status: status, balance: balance, message: msg } }];"
      },
      "notes": "Why Code: looks the invoice up case-insensitively, adds up earlier payments, decides Paid vs Partial and builds the next PAY number. No AI involved in money."
    },
